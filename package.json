{
  "name": "lumen-learn-backend",
  "private": true,
  "workspaces": [
    "packages/types",
    "packages/config",
    "packages/logger",
    "packages/errors",
    "packages/internal-identity",
    "packages/redis-client",
    "packages/queue-helpers",
    "packages/http",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && vitest run",
    "typecheck": "npm run build",
    "lint": "eslint .",
    "dev:gateway": "npm run dev --workspace=@lumen/gateway-api"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.18"
  }
}
